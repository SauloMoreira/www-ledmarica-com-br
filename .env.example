# Supabase - configure via Lovable Cloud Secrets ou seu ambiente local
SUPABASE_URL="https://SEU-PROJECT-ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"
VITE_SUPABASE_URL="https://SEU-PROJECT-ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"
VITE_SUPABASE_PROJECT_ID="SEU-PROJECT-ID"

# Secrets gerenciados exclusivamente via Lovable Cloud Secrets (nunca em arquivo local)
# SUPABASE_SERVICE_ROLE_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# RESEND_API_KEY=
# LOVABLE_API_KEY=
#
# Frete real (Melhor Envio) — sem estes dois, o checkout usa a estimativa por região automaticamente:
# MELHOR_ENVIO_TOKEN=            # Token de API (produção) gerado em melhorenvio.com.br > Gerenciar > Tokens
# MELHOR_ENVIO_ORIGIN_ZIP=24913700  # CEP de origem (loja em Maricá) — opcional, default já é este
# MELHOR_ENVIO_ENV=production     # "sandbox" para testar sem token de produção
